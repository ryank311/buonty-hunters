[gd_resource type="Resource" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/resources/soldier_class.gd" id="script"]
[ext_resource type="Resource" path="res://resources/weapons/smg.tres" id="smg"]
[ext_resource type="Resource" path="res://resources/weapons/pistol.tres" id="pistol"]
[ext_resource type="Resource" path="res://resources/weapons/flash.tres" id="flash"]
[ext_resource type="Resource" path="res://resources/weapons/claymore.tres" id="claymore"]

[resource]
script = ExtResource("script")
display_name = "POINTMAN"
summary = "Submachine gun and 9 mm pistol. Flashbang and claymore."
primary = ExtResource("smg")
secondary = ExtResource("pistol")
equipment = Array[Resource]([ExtResource("flash"), ExtResource("claymore")])
