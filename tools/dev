#!/usr/bin/env bash
# One entry point for building, checking, testing, and looking at the game from a
# terminal. Written for agents: output is short, failures come with file:line, and
# every command exits non-zero when something is wrong.
set -uo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
godot="$root/tools/agent/godot"
out="$root/.agent"

usage() {
	cat <<'EOF'
Usage: tools/dev <command>

  check                 Load every script, scene, and resource headlessly; report parse
                        errors and broken references as file:line. Takes about 2 s.
  test [suite...|--all] Run headless regression suites from tests/. With no argument:
                        the core suites listed in tests/core.txt (about 10 s). Name
                        suites to run those; --all runs every suite (over a minute).
                        A few run at once (SOCOM_TEST_JOBS, default two fewer than the
                        processor's cores); a suite over 20 s is marked SLOW.
  shot [options] [scenario...] [key=value...]
                        Render scenarios to PNG in a hidden window. No arguments lists
                        the scenarios. key=value sets any harness state (level=lab
                        stance=prone ammo=0); step.key=value plays input first
                        (step.frames=45 step.forward=1); --model=<name> stands a model
                        from art/models in the level. Options: --all, --sheet, --state,
                        --full, --show, --at=x,y,z, --yaw=n, --spec='<json>',
                        --step='<json>', --out=<dir>.
  import                Re-import assets and rebuild the global class cache. Needed
                        after adding an asset or a new `class_name`.
  build linux [--debug]  Export, audit and smoke-test a native Linux x86_64 build.
                        Downloads matching, checksum-verified templates on first use.
  deploy linux USER@HOST [--port PORT] [--build DIR]
                        Install the latest build over SSH, headless-test it on Linux,
                        then select it for the stable Steam launcher.
  ship steam [options]   Build and deploy to deck@192.168.86.121, register SOCOM Playtest
                        in Steam with concept-art/Socom_2_Box_Art.jpg. --restart-steam
                        refreshes Steam only when the shortcut/art needs an update.
  blender <command>     The agents' Blender and the .blend -> .glb pipeline: status,
                        start, stop, export, preview. `tools/dev blender help` lists them.
  doctor                Check the toolchain, the MCP setup, and who else is using the project.
  mcp-smoke             Drive the Godot MCP server end to end against this project.
  play                  Start the game in a window as a player would, with the live link
                        on so an agent can inspect and tune it while you play.
  live <command>        The live link to the running game: status, tools, call <tool>
                        ['<json>'], launch [--focus] (open the real game), stop [port],
                        smoke. `sandbox [--port=n]` starts a hidden QA instance for an
                        experiment of your own, reached only with call --port=n.
  godot [args...]       Run Godot through the project wrapper.
EOF
}

# Each invocation writes to its own directory, so agents sharing this checkout never
# read each other's logs or frames. Anything older than an hour is pruned. Godot's own
# log file goes there too (--log-file): a sandboxed agent cannot write to the engine's
# default user:// log folder, and the engine crashes when that write fails.
new_run() {
	local base="$out/$1" run
	mkdir -p "$base"
	[[ -f "$out/.gdignore" ]] || : > "$out/.gdignore"
	find "$base" -mindepth 1 -maxdepth 1 -mmin +60 -exec rm -rf {} + 2>/dev/null
	run="$base/$(date +%H%M%S)-$$"
	mkdir -p "$run"
	echo "$run"
}

# Turns Godot's two-line error records into `path:line: message`.
format_errors() {
	awk '
		/^SCRIPT ERROR: / { message = substr($0, 15); pending = 1; next }
		pending && /^ +at: / {
			pending = 0
			location = ""
			if (match($0, /res:\/\/[^)]+/)) location = substr($0, RSTART + 6, RLENGTH - 6)
			line = (location != "" ? location ": " : "") message
			if (!(line in seen)) { seen[line] = 1; print line }
			next
		}
		/^ERROR: / {
			pending = 0
			if ($0 ~ /Failed to load script/) next
			if (!($0 in seen)) { seen[$0] = 1; print $0 }
		}
	'
}

cmd_check() {
	local run log status problems summary
	run="$(new_run logs)"
	log="$run/check.log"
	"$godot" --headless --path "$root" --log-file "$run/godot.log" --script res://tools/agent/check.gd >"$log" 2>&1
	status=$?
	problems="$(format_errors <"$log")"
	[[ -n "$problems" ]] && echo "$problems"
	# A resource can fail to load without an engine error line; name it anyway.
	sed -n 's/^CHECK_FAILED res:\/\//failed to load: /p' "$log" | while read -r line; do
		echo "$problems" | grep -qF "${line#failed to load: }" || echo "$line"
	done
	summary="$(sed -n 's/^CHECK_DONE //p' "$log")"
	if [[ -z "$summary" ]]; then
		echo "CHECK: did not finish (exit $status). Log: ${log#"$root"/}"
		return 1
	fi
	if [[ $status -ne 0 || -n "$problems" ]]; then
		echo "CHECK: FAIL ($summary)"
		return 1
	fi
	rm -rf "$run"
	echo "CHECK: ok ($summary)"
}

run_suite() {
	local name="$1" log="$2/$1.log" limit="${SOCOM_TEST_TIMEOUT:-240}" started=$SECONDS
	"$godot" --headless --path "$root" --log-file "$2/$name.godot.log" --fixed-fps 60 --script "res://tests/$name.gd" -- --qa >"$log" 2>&1 &
	local pid=$!
	# A suite whose script fails to compile never reaches quit(); do not wait forever.
	# The watchdog gives up its output streams so a caller piping ours is not kept waiting.
	( sleep "$limit"; kill "$pid" 2>/dev/null ) </dev/null >/dev/null 2>&1 &
	local watchdog=$!
	wait "$pid" 2>/dev/null
	local status=$?
	pkill -P "$watchdog" 2>/dev/null
	kill "$watchdog" 2>/dev/null
	wait "$watchdog" 2>/dev/null
	local passed failed
	passed="$(grep -c '^PASS ' "$log")"
	failed="$(grep -c '^FAIL ' "$log")"
	{
		if [[ $status -eq 143 || $status -eq 137 ]]; then
			printf '%-28s TIMEOUT after %ss (%s passed before it stalled)\n' "$name" "$limit" "$passed"
		elif [[ $status -eq 0 && $failed -eq 0 && $passed -gt 0 ]]; then
			printf '%-28s PASS  %3s checks  %ss%s\n' "$name" "$passed" "$((SECONDS - started))" "$([[ $((SECONDS - started)) -gt ${SOCOM_TEST_BUDGET:-20} ]] && echo "  SLOW: over the ${SOCOM_TEST_BUDGET:-20}s a suite is allowed")"
		else
			printf '%-28s FAIL  %s of %s checks failed  %ss\n' "$name" "$failed" "$((passed + failed))" "$((SECONDS - started))"
		fi
		if [[ $status -ne 0 || $failed -gt 0 || $passed -eq 0 ]]; then
			grep '^FAIL ' "$log" | sed 's/^/  /'
			format_errors <"$log" | head -8 | sed 's/^/  /'
			echo "  log: ${log#"$root"/}"
		fi
	} >"$2/$name.summary"
	[[ $status -eq 0 && $failed -eq 0 && $passed -gt 0 ]]
}

# The suites a plain `tools/dev test` runs: tests/core.txt, one name a line.
core_suites() {
	sed -e 's/#.*//' -e 's/[[:space:]]//g' "$root/tests/core.txt" 2>/dev/null | grep -v '^$'
}

cmd_test() {
	local suites=() name available all=0 names=()
	available="$(cd "$root/tests" && grep -l '^extends SceneTree' *.gd 2>/dev/null | sed 's/\.gd$//')"
	for name in "$@"; do
		if [[ "$name" == "--all" ]]; then all=1; else names+=("$name"); fi
	done
	if [[ ${#names[@]} -gt 0 ]]; then
		for name in "${names[@]}"; do
			name="${name%.gd}"
			name="${name##*/}"
			if ! echo "$available" | grep -qx "$name"; then
				echo "No suite tests/$name.gd. Available: $(echo $available)"
				return 2
			fi
			suites+=("$name")
		done
	elif [[ $all -eq 1 ]]; then
		for name in $available; do
			suites+=("$name")
		done
	else
		for name in $(core_suites); do
			if echo "$available" | grep -qx "$name"; then
				suites+=("$name")
			else
				echo "tests/core.txt names $name, but there is no tests/$name.gd"
			fi
		done
	fi
	if [[ ${#suites[@]} -eq 0 ]]; then
		echo "TESTS: no suites found in tests/"
		return 1
	fi
	# A few at a time, leaving two cores for the game being played and whoever else is
	# working here. Starting every suite at once only makes them all slow.
	local cores limit
	cores="$(sysctl -n hw.physicalcpu 2>/dev/null || getconf _NPROCESSORS_ONLN 2>/dev/null || echo 4)"
	limit="${SOCOM_TEST_JOBS:-$((cores > 4 ? cores - 2 : 2))}"
	local run pids=() failures=0 index=0 began=$SECONDS
	run="$(new_run logs)"
	for name in "${suites[@]}"; do
		while [[ $(jobs -rp | wc -l) -ge $limit ]]; do
			sleep 0.2
		done
		run_suite "$name" "$run" &
		pids+=($!)
	done
	for name in "${suites[@]}"; do
		wait "${pids[$index]}" || failures=$((failures + 1))
		cat "$run/$name.summary"
		index=$((index + 1))
	done
	local shape="${#suites[@]} suite$([[ ${#suites[@]} -eq 1 ]] || echo s), $((SECONDS - began))s"
	if [[ ${#names[@]} -eq 0 && $all -eq 0 ]]; then
		shape="$shape; core only, --all runs every suite"
	fi
	if [[ $failures -gt 0 ]]; then
		echo "TESTS: FAIL ($failures of $shape)"
		return 1
	fi
	rm -rf "$run"
	echo "TESTS: ok ($shape)"
}

cmd_shot() {
	local run log shots="" arg show=0 status args=("$@")
	for arg in "$@"; do
		[[ "$arg" == "--show" ]] && show=1
		[[ "$arg" == --out=* ]] && shots="${arg#--out=}"
	done
	if [[ -z "$shots" ]]; then
		shots="$(new_run shots)"
		args+=("--out=$shots")
	fi
	run="$(new_run logs)"
	log="$run/shot.log"
	SOCOM_AGENT_SHOW=$show "$godot" --path "$root" --log-file "$run/godot.log" --script res://tools/agent/capture.gd -- --qa "${args[@]}" >"$log" 2>&1 &
	local pid=$! limit="${SOCOM_SHOT_TIMEOUT:-120}"
	# A script error leaves the capture window running with nothing to do; end it.
	( sleep "$limit"; kill "$pid" 2>/dev/null ) </dev/null >/dev/null 2>&1 &
	local watchdog=$!
	wait "$pid" 2>/dev/null
	status=$?
	pkill -P "$watchdog" 2>/dev/null
	kill "$watchdog" 2>/dev/null
	wait "$watchdog" 2>/dev/null
	grep -E '^(SHOT|SHEET|Scenarios:|capture:) ?' "$log"
	format_errors <"$log" | head -12
	rmdir "$shots" 2>/dev/null
	if [[ $status -eq 143 || $status -eq 137 ]]; then
		echo "SHOT: TIMEOUT after ${limit}s. Log: ${log#"$root"/}"
		return 1
	fi
	if [[ $status -ne 0 ]]; then
		echo "SHOT: FAIL (exit $status). Log: ${log#"$root"/}"
		return 1
	fi
	rm -rf "$run"
}

cmd_import() {
	local run log status
	run="$(new_run logs)"
	log="$run/import.log"
	"$godot" --headless --path "$root" --log-file "$run/godot.log" --import >"$log" 2>&1
	status=$?
	# A sandboxed agent cannot save Godot's editor settings; that does not affect the import.
	format_errors <"$log" | grep -v 'editor.settings' | head -20
	if [[ $status -ne 0 ]]; then
		echo "IMPORT: FAIL (exit $status). Log: ${log#"$root"/}"
		return 1
	fi
	rm -rf "$run"
	echo "IMPORT: ok"
}

cmd_doctor() {
	local problems=0 version wanted
	version="$("$godot" --version 2>/dev/null)" || { echo "FAIL  Godot not found (set GODOT_BIN)"; problems=1; }
	wanted="$(sed -n 's/^config\/features=PackedStringArray("\([0-9.]*\)".*/\1/p' "$root/project.godot")"
	if [[ -n "$version" ]]; then
		if [[ "$version" == "$wanted"* ]]; then
			echo "ok    Godot $version"
		else
			echo "WARN  Godot $version, but project.godot targets $wanted"
		fi
	fi
	if command -v node >/dev/null 2>&1 && [[ "$(node -p 'process.versions.node.split(".")[0]')" -ge 20 ]]; then
		echo "ok    Node $(node --version) (the MCP server needs 20+)"
	else
		echo "FAIL  Node 20+ not found; the MCP server cannot start"
		problems=1
	fi
	for config in .mcp.json .codex/config.toml; do
		if grep -q 'tools/agent/mcp' "$root/$config" 2>/dev/null; then
			echo "ok    $config registers the godot MCP server"
		else
			echo "WARN  $config does not register the godot MCP server"
		fi
		if grep -q 'tools/agent/live-mcp.mjs' "$root/$config" 2>/dev/null; then
			echo "ok    $config registers the game MCP server (the live link)"
		else
			echo "WARN  $config does not register the game MCP server (the live link)"
		fi
	done
	if grep -q '^Live="\*res://scripts/live/live_boot.gd"' "$root/project.godot"; then
		local live
		live="$(node "$root/tools/agent/live-mcp.mjs" status 2>/dev/null | grep -E '^[0-9]+ ')"
		if [[ -n "$live" ]]; then
			echo "note  running with the live link (the game MCP server acts only on \"the game\"):"
			echo "$live" | sed 's/^/        /'
		fi
	else
		echo "FAIL  project.godot has no Live autoload; running games cannot be reached by the game MCP server"
		problems=1
	fi
	local owners
	owners="$(ls "$root/.mcp/godot-runtime/bridge/owners" 2>/dev/null | wc -l | tr -d ' ')"
	if grep -q '^McpBridge=' "$root/project.godot"; then
		if [[ "$owners" -gt 0 ]]; then
			echo "ok    MCP runtime session live ($owners); project.godot carries its temporary McpBridge autoload"
		else
			echo "FAIL  project.godot has a leftover McpBridge autoload and no live session; delete that line"
			problems=1
		fi
	fi
	local missing=""
	while read -r class; do
		grep -q "\"class\": &\"$class\"" "$root/.godot/global_script_class_cache.cfg" 2>/dev/null || missing="$missing $class"
	done < <(grep -rhs --include='*.gd' --exclude-dir='.*' '^class_name ' "$root" | awk '{print $2}')
	if [[ -n "$missing" ]]; then
		if pgrep -f "Godot.*--path $root.*--editor" >/dev/null 2>&1; then
			echo "FAIL  class cache is missing:$missing (focus the open Godot editor so it rescans, or run: tools/dev import)"
		else
			echo "FAIL  class cache is missing:$missing (run: tools/dev import)"
		fi
		problems=1
	else
		echo "ok    global class cache is current"
	fi
	source "$root/tools/agent/blender/commands.sh"
	local blender
	if blender="$(find_blender 2>/dev/null)"; then
		echo "ok    $("$blender" --version 2>/dev/null | head -1)"
		if command -v uvx >/dev/null 2>&1; then
			echo "ok    uv $(uv --version 2>/dev/null | awk '{print $2}') (runs the Blender MCP server)"
			# A cold package cache means a download and a native build at the next start,
			# which is slower than an agent waits for an MCP server.
			if ! DISABLE_TELEMETRY=true uvx --offline --python 3.11 "mcp-for-blender@$(cat "$blender_dir/mcp-version")" --help >/dev/null 2>&1; then
				echo "WARN  the Blender MCP package is not cached; run tools/dev blender smoke once to fetch and build it"
			fi
		else
			echo "FAIL  uvx not found; the Blender MCP server cannot start (install uv: https://docs.astral.sh/uv/)"
			problems=1
		fi
		for config in .mcp.json .codex/config.toml; do
			if grep -q 'tools/agent/blender-mcp.mjs' "$root/$config" 2>/dev/null; then
				echo "ok    $config registers the blender MCP server"
			else
				echo "WARN  $config does not register the blender MCP server"
			fi
		done
		local instances
		instances="$(blender_status)"
		[[ "$instances" == port* ]] && echo "$instances" | sed 's/^/note  agent Blender: /'
	else
		echo "WARN  Blender not found; modelling tools are unavailable (set BLENDER_BIN)"
	fi
	local others
	others="$(pgrep -fl "Godot.*--path $root" 2>/dev/null | sed -E 's/^([0-9]+) .*Godot /\1 /' | cut -c1-110)"
	if [[ -n "$others" ]]; then
		echo "note  Godot processes on this project (leave any you did not start):"
		echo "$others" | sed 's/^/        /'
	fi
	return $problems
}

command="${1:-help}"
[[ $# -gt 0 ]] && shift
case "$command" in
	check) cmd_check ;;
	test) cmd_test "$@" ;;
	shot) cmd_shot "$@" ;;
	import) cmd_import ;;
	build|deploy|ship) exec python3 "$root/tools/build/linux.py" "$command" "$@" ;;
	doctor) cmd_doctor ;;
	blender)
		source "$root/tools/agent/blender/commands.sh"
		cmd_blender "$@" ;;
	mcp-smoke) exec node "$root/tools/agent/mcp_smoke.mjs" "$@" ;;
	play) SOCOM_AGENT_QA=0 SOCOM_AGENT_SHOW=1 exec "$godot" --path "$root" "$@" ;;
	live)
		if [[ "${1:-}" == "smoke" ]]; then
			shift
			exec node "$root/tools/agent/live_smoke.mjs" "$@"
		fi
		exec node "$root/tools/agent/live-mcp.mjs" "${@:-status}" ;;
	godot) exec "$godot" "$@" ;;
	help|-h|--help) usage ;;
	*) echo "Unknown command: $command"; usage; exit 2 ;;
esac
